{
  "name": "AI Lead Qualification & Routing Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inbound-lead",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -944,
        128
      ],
      "id": "e4ca7406-b85e-47cb-850b-c2e5148293a6",
      "name": "Webhook Intake",
      "webhookId": "5a9475a2-0741-451d-b34c-d40ee1ad0c2e"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json.body || item.json;\n  const firstName = (data.first_name || '').trim();\n  const lastName = (data.last_name || '').trim();\n  const email = (data.email || '').trim().toLowerCase();\n  const company = (data.company || '').trim();\n  const budget = (data.budget || '').trim();\n  const message = (data.message || '').trim();\n\n  const domain = email.split('@')[1] || '';\n  const freeProviders = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com'];\n  const isBusinessEmail = domain !== '' && !freeProviders.includes(domain);\n\n  return {\n    json: {\n      fullName: `${firstName} ${lastName}`.trim() || 'Anonymous Lead',\n      firstName,\n      lastName,\n      email,\n      domain,\n      isBusinessEmail,\n      company: company || (isBusinessEmail ? domain.split('.')[0].toUpperCase() : 'Not Specified'),\n      budget,\n      message,\n      receivedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        128
      ],
      "id": "6c8340e9-90e2-4813-9bda-a2ddc9f1fbe4",
      "name": "Normalize Input Data"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.isBusinessEmail }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "High Priority (Business Lead)"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
